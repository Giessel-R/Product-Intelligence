  "triggerCount": 1,
  "tags": [],
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner",
    "availableInMCP": false
  },
  "staticData": {
    "node:Daily 6:00 AM": {
      "recurrenceRules": []
    }
  },
  "meta": null,
  "pinData": null,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * 1-5"
            }
          ]
        }
      },
      "id": "cred-schedule",
      "name": "Daily 6:00 AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {},
      "id": "cred-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [240, 460]
    },
    {
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_SHEETS_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "config",
          "mode": "name"
        },
        "filtersUI": {},
        "options": {
          "range": "A1:B2"
        }
      },
      "id": "check-sheets",
      "name": "Check Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [500, 300],
      "continueOnFail": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "YOUR_GSHEETS_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://www.googleapis.com/gmail/v1/users/me/profile",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "gmailOAuth2",
        "options": {}
      },
      "id": "check-gmail",
      "name": "Check Gmail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 300],
      "continueOnFail": true,
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const sheetsFirst = $('Check Google Sheets').first().json;\nconst gmailFirst = $('Check Gmail').first().json;\n\nconst sheetsOk = !sheetsFirst.error;\nconst gmailOk = !gmailFirst.error;\n\nconst failures = [];\nif (!sheetsOk) failures.push({ service: 'Google Sheets', error: String(sheetsFirst.error).substring(0, 300) });\nif (!gmailOk) failures.push({ service: 'Gmail', error: String(gmailFirst.error).substring(0, 300) });\n\nreturn [{\n  json: {\n    sheetsOk,\n    gmailOk,\n    anyFailed: failures.length > 0,\n    failureCount: failures.length,\n    failures,\n    checkedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "evaluate-auth",
      "name": "Evaluate Auth Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1020, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "failure-count-check",
              "leftValue": "={{ $json.failureCount }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "any-failed",
      "name": "Any Failed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1280, 300]
    },
    {
      "parameters": {
        "jsCode": "const { failures, checkedAt, sheetsOk, gmailOk } = $input.first().json;\n\nconst serviceList = failures.map(f =>\n  `<li><strong>${f.service}</strong> \u2014 ${f.error}</li>`\n).join('');\n\nconst affected = failures.map(f => f.service).join(' + ');\nconst subject = `\u26a0\ufe0f PI System: Re-auth required \u2014 ${affected}`;\n\nconst body = `\n<h2>Credential Health Check Alert</h2>\n<p>One or more credentials used by the Product Intelligence system have expired or been revoked.\nThe 6:30 AM workflow run will fail until these are fixed.</p>\n\n<h3>Affected credentials</h3>\n<ul>${serviceList}</ul>\n\n<h3>How to fix</h3>\n<ol>\n  <li>Open n8n \u2192 <strong>Settings \u2192 Credentials</strong></li>\n  <li>Find the affected credential and click <strong>Reconnect</strong></li>\n  <li>Re-authenticate with Google</li>\n  <li>Manually trigger <strong>PI: Master Orchestrator</strong> to catch up today's run</li>\n</ol>\n\n<p style=\"color:#888;font-size:12px\">Checked at: ${checkedAt} \u00b7 Google Sheets: ${sheetsOk ? '\u2705' : '\u274c'} \u00b7 Gmail: ${gmailOk ? '\u2705' : '\u274c'}</p>\n`;\n\nreturn [{ json: { subject, body } }];"
      },
      "id": "build-alert",
      "name": "Build Alert Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 200]
    },
    {
      "parameters": {
        "sendTo": "YOUR_EMAIL@example.com",
        "subject": "={{ $json.subject }}",
        "message": "={{ $json.body }}",
        "options": {}
      },
      "id": "send-alert-email",
      "name": "Send Alert Email",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [1800, 200],
      "credentials": {
        "gmailOAuth2": {
          "id": "YOUR_GMAIL_CREDENTIAL_ID",
          "name": "Gmail account"
        }
      }
    },
    {
      "parameters": {
        "content": "PI: Credential Health Check\n\nRuns Mon\u2013Fri at 6:00 AM \u2014 30 min before the Orchestrator.\nTests Google Sheets + Gmail OAuth with lightweight reads.\nEmails YOUR_EMAIL@example.com if either credential has expired.\n\nNote: if Gmail itself expires, this workflow will error\nand the Error Handler fires instead."
      },
      "type": "n8n-nodes-base.stickyNote",
      "position": [240, 120],
      "typeVersion": 1,
      "id": "health-check-note",
      "name": "Sticky Note"
    }
  ],
