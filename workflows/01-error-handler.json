    {
      "parameters": {
        "jsCode": "const errorData = $input.first().json;\n\nconst workflowName = errorData.workflow?.name || 'unknown';\nconst nodeName = errorData.execution?.lastNodeExecuted || 'unknown';\nconst errorMessage = errorData.error?.message || 'unknown error';\nconst errorStack = errorData.error?.stack || '';\nconst executionId = errorData.execution?.id || '';\nconst runId = errorData.execution?.customData?.runId || '';\n\n// Determine severity\nconst criticalWorkflows = ['PI: Master Orchestrator', 'PI: Newsletter', 'PI: Error Handler'];\nconst isCritical = criticalWorkflows.includes(workflowName);\n\nconst errorRecord = {\n  id: `ERR-${Date.now()}`,\n  timestamp: new Date().toISOString(),\n  run_id: runId || executionId,\n  workflow_name: workflowName,\n  node_name: nodeName,\n  error_message: errorMessage.substring(0, 500),\n  input_data: JSON.stringify(errorData.execution?.lastNodeExecuted || {}).substring(0, 300),\n  retry_count: 0,\n  resolved: 'FALSE',\n  severity: isCritical ? 'critical' : 'non-critical'\n};\n\nreturn [{ json: errorRecord }];"
      },
      "id": "build-error-record",
      "name": "Build Error Record",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
