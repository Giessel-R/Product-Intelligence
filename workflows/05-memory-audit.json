    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst week = new Date().toISOString().substring(0,7);\nconst thisWeek = items.filter(i => i.json.week === week && i.json.status !== 'archived');\nconst risky = [];\nfor (const item of thisWeek) {\n  const d = item.json;\n  const conf = parseInt(d.confidence_score) || 0;\n  const rel = parseInt(d.relevance_score) || 0;\n  const isRisky = (conf <= 2 && rel >= 4) || d.review_flag === 'TRUE';\n  if (isRisky) risky.push({ id: d.finding_id, reason: d.review_flag_reason || 'low confidence + high relevance', confidence_score: conf, relevance_score: rel });\n}\nreturn [{ json: { week, total_findings: thisWeek.length, flagged_count: risky.length, flagged_items: risky, findings_to_archive: thisWeek.map(i=>i.json.finding_id) } }];"
      },
